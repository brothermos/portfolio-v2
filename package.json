{
  "name": "portfolio-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:portfolio": "npm run dev --prefix apps/portfolio",
    "dev:all": "concurrently -k -n web,portfolio -c cyan,magenta \"npm run dev\" \"npm run dev:portfolio\"",
    "build": "tsc -b && vite build",
    "build:portfolio": "npm run build --prefix apps/portfolio",
    "lint": "eslint .",
    "lint:portfolio": "npm run lint --prefix apps/portfolio",
    "preview": "vite preview",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@vercel/speed-insights": "^2.0.0",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.14.2",
    "pg": "^8.21.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.6.0",
    "swiper": "^14.0.7",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "prettier-plugin-classnames": "^0.10.4",
    "prettier-plugin-merge": "^0.10.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.2.0",
    "vite-imagetools": "^11.0.0"
  }
}
