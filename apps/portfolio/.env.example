# Logo.dev — copy to .env.local and fill in your keys
NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY=
LOGO_DEV_SECRET_KEY=

# SEC Thailand Open API V2 (https://secopendata.sec.or.th)
SEC_API_KEY=

# Portfolio admin editor (https://wealth.bromos.dev/admin)
# Password for /admin login
PORTFOLIO_ADMIN_SECRET=

# Upstash Redis — shared live portfolio data (stocks, cash, funds, closed)
# Create a free Redis DB at https://console.upstash.com then paste REST credentials
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
